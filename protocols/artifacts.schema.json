{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memory-benchmark:artifacts:0.2.0-draft",
  "title": "Memory Benchmark Artifact Contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/HistoryArtifact"
    },
    {
      "$ref": "#/$defs/PublicQuestionArtifact"
    },
    {
      "$ref": "#/$defs/PrivateTargetArtifact"
    },
    {
      "$ref": "#/$defs/AddReceipt"
    },
    {
      "$ref": "#/$defs/RetrievalArtifact"
    },
    {
      "$ref": "#/$defs/EvidenceBundle"
    },
    {
      "$ref": "#/$defs/PredictionArtifact"
    },
    {
      "$ref": "#/$defs/JudgementArtifact"
    },
    {
      "$ref": "#/$defs/AnnotationArtifact"
    },
    {
      "$ref": "#/$defs/DiagnosisArtifact"
    },
    {
      "$ref": "#/$defs/RunManifest"
    }
  ],
  "$defs": {
    "SourceFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "SourceLocator": {
      "type": "object",
      "properties": {
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_pointer": {
          "type": "string"
        },
        "message_pointer": {
          "type": "string"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "file_sha256",
        "record_pointer",
        "message_pointer",
        "char_start",
        "char_end"
      ],
      "additionalProperties": false
    },
    "TimeInfo": {
      "type": "object",
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parsed_iso8601": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "unknown",
            "year",
            "month",
            "day",
            "minute",
            "second",
            "subsecond"
          ]
        },
        "parse_status": {
          "type": "string",
          "enum": [
            "exact",
            "ambiguous",
            "missing",
            "invalid"
          ]
        }
      },
      "required": [
        "raw",
        "parsed_iso8601",
        "timezone",
        "precision",
        "parse_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "parse_status": {
                "const": "exact"
              }
            },
            "required": [
              "parse_status"
            ]
          },
          "then": {
            "properties": {
              "raw": {
                "type": "string"
              },
              "parsed_iso8601": {
                "type": "string",
                "format": "date-time"
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "precision": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "parse_status": {
                "const": "missing"
              }
            },
            "required": [
              "parse_status"
            ]
          },
          "then": {
            "properties": {
              "raw": {
                "type": "null"
              },
              "parsed_iso8601": {
                "type": "null"
              },
              "timezone": {
                "type": "null"
              },
              "precision": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "parse_status": {
                "enum": [
                  "ambiguous",
                  "invalid"
                ]
              }
            },
            "required": [
              "parse_status"
            ]
          },
          "then": {
            "properties": {
              "raw": {
                "type": "string"
              },
              "parsed_iso8601": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "SourceMessageArtifact": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "source_order": {
          "type": "integer"
        },
        "speaker_id": {
          "type": "string"
        },
        "speaker_type": {
          "type": "string",
          "enum": [
            "human",
            "assistant",
            "tool",
            "system",
            "unknown"
          ]
        },
        "original_role": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public_history",
            "hidden_persona",
            "public_task_instruction",
            "other_system",
            "unclassified_system"
          ]
        },
        "content": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "time": {
          "$ref": "#/$defs/TimeInfo"
        }
      },
      "required": [
        "message_id",
        "session_id",
        "source_order",
        "speaker_id",
        "speaker_type",
        "original_role",
        "visibility",
        "content",
        "content_sha256",
        "source_locator",
        "time"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "speaker_type": {
                "const": "system"
              }
            },
            "required": [
              "speaker_type"
            ]
          },
          "then": {
            "properties": {
              "visibility": {
                "not": {
                  "const": "public_history"
                }
              }
            }
          }
        }
      ]
    },
    "HistoryArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2.0-draft"
        },
        "history_id": {
          "type": "string"
        },
        "family_id": {
          "type": "string"
        },
        "dataset_id": {
          "type": "string"
        },
        "source_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceFile"
          },
          "minItems": 1
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceMessageArtifact"
          },
          "minItems": 1
        },
        "loader_version": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "history_id",
        "family_id",
        "dataset_id",
        "source_files",
        "messages",
        "loader_version",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "AllowedHistory": {
      "type": "object",
      "properties": {
        "last_message_id": {
          "type": "string"
        },
        "last_source_order": {
          "type": "integer"
        },
        "prefix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "last_message_id",
        "last_source_order",
        "prefix_sha256"
      ],
      "additionalProperties": false
    },
    "OptionArtifact": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "content"
      ],
      "additionalProperties": false
    },
    "PublicQuestionArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2.0-draft"
        },
        "question_id": {
          "type": "string"
        },
        "dataset_id": {
          "type": "string"
        },
        "history_id": {
          "type": "string"
        },
        "family_id": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "task_type": {
          "type": "string",
          "enum": [
            "choice",
            "factual_text",
            "numeric",
            "rubric_response",
            "unanswerable"
          ]
        },
        "allowed_history": {
          "$ref": "#/$defs/AllowedHistory"
        },
        "public_instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionArtifact"
          }
        },
        "source_locator": {
          "$ref": "#/$defs/SourceLocator"
        }
      },
      "required": [
        "schema_version",
        "question_id",
        "dataset_id",
        "history_id",
        "family_id",
        "query",
        "task_type",
        "allowed_history",
        "public_instructions",
        "options",
        "source_locator"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "choice"
              }
            },
            "required": [
              "task_type"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "enum": [
                  "factual_text",
                  "numeric",
                  "rubric_response",
                  "unanswerable"
                ]
              }
            },
            "required": [
              "task_type"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Criterion": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "requirement": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "requirement",
        "weight",
        "source"
      ],
      "additionalProperties": false
    },
    "PrivateTargetArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2.0-draft"
        },
        "question_id": {
          "type": "string"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "choice",
            "factual_text",
            "numeric",
            "rubric_response",
            "unanswerable"
          ]
        },
        "answer": {},
        "acceptable_answers": {
          "type": "array",
          "items": {}
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "numeric_policy": {
          "type": "object",
          "additionalProperties": {}
        },
        "answerability": {
          "type": "string",
          "enum": [
            "answerable",
            "unanswerable",
            "uncertain"
          ]
        },
        "origin": {
          "$ref": "#/$defs/SourceLocator"
        }
      },
      "required": [
        "schema_version",
        "question_id",
        "target_type",
        "answer",
        "acceptable_answers",
        "criteria",
        "numeric_policy",
        "answerability",
        "origin"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target_type": {
                "const": "choice"
              }
            },
            "required": [
              "target_type"
            ]
          },
          "then": {
            "properties": {
              "answer": {
                "type": "object",
                "properties": {
                  "correct_option_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "correct_option_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_type": {
                "const": "rubric_response"
              }
            },
            "required": [
              "target_type"
            ]
          },
          "then": {
            "properties": {
              "criteria": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "estimated_cost_usd"
      ],
      "additionalProperties": false
    },
    "Timing": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "number"
        }
      },
      "required": [
        "started_at",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "AddReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2.0-draft"
        },
        "run_id": {
          "type": "string"
        },
        "method_id": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "history_prefix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "batch_id": {
          "type": "string"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acknowledged": {
          "type": "boolean",
          "const": true
        },
        "backend_state_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "method_id",
        "namespace",
        "history_prefix_sha256",
        "batch_id",
        "payload_sha256",
        "acknowledged",
        "backend_state_ref",
        "attempts",
        "usage",
        "timing"
      ],
      "additionalProperties": false
    },
    "RetrievalRequest": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "top_k": {
          "type": "integer"
        },
        "options": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "user_id",
        "query",
        "top_k",
        "options"
      ],
      "additionalProperties": false
    },
    "OriginLink": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message_id",
        "char_start",
        "char_end"
      ],
      "additionalProperties": false
    },
    "RetrievalHit": {
      "type": "object",
      "properties": {
        "hit_id": {
          "type": "string"
        },
        "rank": {
          "type": "integer"
        },
        "content": {
          "type": "string"
        },
        "method_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OriginLink"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "hit_id",
        "rank",
        "content",
        "method_score",
        "origin_links",
        "extensions"
      ],
      "additionalProperties": false
    },
    "RetrievalArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2.0-draft"
        },
        "retrieval_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "question_id": {
          "type": "string"
        },
        "method_id": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/RetrievalRequest"
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrievalHit"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "client_error",
            "server_error",
            "timeout",
            "invalid_response"
          ]
        },
        "attempts": {
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        }
      },
      "required": [
        "schema_version",
        "retrieval_id",
        "run_id",
        "question_id",
        "method_id",
        "namespace",
        "request",
        "hits",
        "status",
        "attempts",
        "usage",
        "timing"
      ],
      "additionalProperties": false
    },
    "PresentedHit": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "hit": {
          "$ref": "#/$defs/RetrievalHit"
        },
        "token_count": {
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "hit",
        "token_count"
      ],
      "additionalProperties": false
    },
    "OmittedHit": {
      "type": "object",
      "properties": {
        "hit_id": {
          "type": "string"
        },
        "rank": {
          "type": "integer"
        },
        "reason": {
          "type": "string",
          "enum": [
            "budget_exceeded",
            "invalid_content",
            "policy_excluded"
          ]
        },
        "token_count": {
          "type": "integer"
        }
      },
      "required": [
        "hit_id",
        "rank",
        "reason",
        "token_count"
      ],
      "additionalProperties": false
    },
    "Transformation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "hit_id": {
          "type": "string"
        },
        "source_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "hit_id",
        "source_start",
        "source_end",
        "detail"
      ],
      "additionalProperties": false
    },
    "EvidenceBundle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2.0-draft"
        },
        "bundle_id": {
          "type": "string"
        },
        "retrieval_id": {
          "type": "string"
        },
        "question_id": {
          "type": "string"
        },
        "tokenizer_id": {
          "type": "string"
        },
        "tokenizer_revision": {
          "type": "string"
        },
        "budget_tokens": {
          "type": "integer"
        },
        "used_tokens": {
          "type": "integer"
        },
        "presented_hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresentedHit"
          }
        },
        "omitted_hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OmittedHit"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transformation"
          }
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "bundle_id",
        "retrieval_id",
        "question_id",
        "tokenizer_id",
        "tokenizer_revision",
        "budget_tokens",
        "used_tokens",
        "presented_hits",
        "omitted_hits",
        "transformations",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "PredictionArtifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.2.0-draft"
        },
        "prediction_id": {
          "type": "string"
        },
        "question_id": {
